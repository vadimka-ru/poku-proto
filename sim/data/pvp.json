// Team deathmatch. Only the differences from config/balance.json live here: every key left out
// falls back to the SimConfig default, and those defaults are balance.json, so this is a complete
// config without repeating the whole of it.
{
  "Mode": "Deathmatch",

  "KillsToWin": 30,             // first team there wins...
  "MatchTicks": 18000,          // ...or the one ahead after 5 minutes; a tie goes to overtime
  "OvertimeTicks": 3600,        // at most 1 minute; still tied (kills are the score here), it is a draw
  "RespawnTicks": 180,          // 3 s on the floor
  "SpawnProtectionTicks": 60,   // 1 s untouchable after coming back
  "PointsPerPlayerKill": 0,     // nothing to buy in PvP, so kills earn no points
  "SpawnDistanceTiles": 40,     // walking distance between the two sides at the start
  "RespawnMinEnemyDistance": 18,// never come back within this many tiles of an enemy
  "RespawnPointSpacing": 12,    // how thinly the respawn points are spread over the town
  "OpenAllDoors": true,         // nothing is for sale here, so no door may stay shut

  "BotEngageRange": 7,          // how close a bot comes before it circles
  "BotAimSpreadPercent": 10,    // used only when BotAimMissTiles is 0
  "BotAimMissTiles": 0.7,       // a bot's aim is off by up to 0.7 tile sideways, near or far
  "BotReactionTicks": 18,       // 0.3 s before a bot opens fire on someone who just came into view
  "BotShotGapTicks": 40,        // at most one charge every 0.67 s, not all three at once

  // Nobody wants to open a match with a pistol against another human.
  "StartingWeapon": "smg",
  "StartingPoints": 0,

  // No waves, no horde: a deathmatch never spawns a zombie.
  "FirstWaveDelayTicks": 2147483647,
  "MaxZombies": 1,

