  // SpreadPercent = 100 x tan(half the cone). Ticks: 60 per second.
  // heroes are 24 px wide, almost a tile
  "PlayerRadius": 0.45,
  "BrawlerRegenDelayTicks": 180,        // 3 s without damage, then...
  "BrawlerRegenPercentPerSecond": 13,   // ...13% of max health a second
  "BushRevealRange": 2,         // in a bush you are hidden from enemies farther than this, in tiles
  "BushRevealTicks": 60,        // attacking or being hit shows you for 1 s
